# ============================================================
# LMS 环境变量模板
#
# 用法：
#   1) 复制本文件为 .env（同目录，已被 .gitignore 忽略）
#   2) 填入真实值后执行 `docker compose up -d --build`
#      或直接在 IDE / shell 中导出这些变量再启动 Spring Boot
#
# 注意：绝不能把真实密钥提交到仓库。
# ============================================================

# ---------- 数据库 ----------
# 本地 Spring Boot 直连时的 JDBC URL（Docker Compose 会覆盖为 mysql-db 主机名）
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/lms_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me

# Docker Compose 使用的 MySQL 容器参数
MYSQL_DATABASE=lms_db
MYSQL_USER=lmsuser
MYSQL_PASSWORD=change-me-too
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_HOST_PORT=3306
BACKEND_PORT=8080

# ---------- JWT ----------
# 【重要】本项目用 HS512 签发 token，JJWT 要求密钥【字符串长度 ≥ 64 字符】（512 bit）。
# 长度不足时应用能正常启动，但登录签发 token 会抛 WeakKeyException → HTTP 500。
# 生成示例：openssl rand -hex 48   （96 字符，远高于下限）
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ---------- 邮件（163 SMTP） ----------
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USERNAME=your-account@163.com
# 163 邮箱的「客户端授权码」，不是登录密码
MAIL_PASSWORD=change-me
# 本地无 SMTP 凭据时可设为 false：注册/找回密码流程不会因发信失败而整体失败
APP_MAIL_ENABLED=true

# ---------- 安全策略 ----------
MAX_FAILED_ATTEMPTS=5
LOCK_DURATION_MINUTES=15
# 允许跨域访问后端的前端来源（逗号分隔；生产环境请替换为真实域名）
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# ---------- 其它 ----------
SERVER_PORT=8080
JPA_SHOW_SQL=false
